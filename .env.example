PORT=3000
NODE_ENV=development

# MongoDB Atlas — use either MONGODB_URI or DB_USER + DB_PASS
DB_USER=
DB_PASS=
# MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/?appName=Cluster0
# MONGODB_HOST=cluster0.dwghg78.mongodb.net
# MONGODB_APP_NAME=Cluster0
# MONGODB_DB_NAME=issueDB

# JWT (API access tokens after Firebase login)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Firebase Admin — option A: path to service account JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Firebase Admin — option B: inline credentials (from Firebase console)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Development only — POST /api/v1/auth/firebase accepts { email, name } without idToken
# (disabled when NODE_ENV=production). idToken still works when Firebase is configured.

# Phase 3 — bootstrap first admin (after Firebase login creates the user)
# npm run promote-admin -- your@email.com
# ADMIN_EMAIL=your@email.com
